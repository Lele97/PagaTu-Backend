# PagaTu Environment Variables Template
# Copy this file to .env and replace with your actual values
# NEVER commit .env file to version control

# ==================================================
# JWT Configuration
# ==================================================
# Generate a secure 256-bit key using: openssl rand -base64 32
JWT_SECRET=CHANGE_ME_TO_SECURE_256_BIT_KEY
JWT_EXPIRATION=86400000

# ==================================================
# Database Configuration
# ==================================================
DB_HOST=pg-pagatu
DB_PORT=5432
DB_NAME_AUTH=auth
DB_NAME_COFFEE=coffee
DB_USERNAME=pagatu
DB_PASSWORD=CHANGE_ME_TO_SECURE_DB_PASSWORD

# PostgreSQL Root Password
POSTGRES_PASSWORD=CHANGE_ME_TO_SECURE_ROOT_PASSWORD

# ==================================================
# Email Configuration
# ==================================================
# Di default le email restano in locale, intercettate da Mailpit.
# UI: http://localhost:8025   SMTP: localhost:1025
#
# Nessuna credenziale necessaria in sviluppo, e nessun rischio di inviare
# email vere per errore.
#
# Per usare un SMTP reale (Gmail, SES, ...) sostituisci i valori qui sotto.
# Con Gmail serve una "app password", non la password dell'account:
# https://myaccount.google.com/apppasswords
# La app password va qui, e SOLO qui: mai nel compose, mai in application.yml.
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_PORT=1025
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false

# ==================================================
# Application Configuration
# ==================================================
DOMAIN_URL=http://localhost:8888

# ==================================================
# CORS Configuration
# ==================================================
CORS_ALLOWED_ORIGINS=http://localhost:8888,https://*.trycloudflare.com,https://*.ngrok-free.app
CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS,HEAD
CORS_ALLOWED_HEADERS=Authorization,Content-Type,Accept-Language,Cache-Control,X-Requested-With,ngrok-skip-browser-warning,Accept,Origin,Access-Control-Request-Method,Access-Control-Request-Headers,Access-Control-Allow-Origin,X-Reset-Token
CORS_EXPOSED_HEADERS=Authorization,Content-Type

# ==================================================
# Service URLs
# ==================================================
EUREKA_URL=http://eureka:8080/eureka/

# ==================================================
# OAuth (Google / Microsoft)
# ==================================================
# Il backend NON usa client id: valida i token chiamando direttamente
# le API del provider (oauth2.googleapis.com/tokeninfo, graph.microsoft.com/v1.0/me).
#
# I client id servono solo al FRONTEND e stanno li':
#   PagaTu-FrontEnd/.env.local  ->  VITE_GOOGLE_CLIENT_ID
#                                    VITE_MICROSOFT_CLIENT_ID
# Se non sono impostati, i pulsanti OAuth semplicemente non vengono mostrati.

# ==================================================
# Development Settings
# ==================================================
# Nota: i file docker-compose.yml e docker-compose.local.yaml hanno le porte
# dei container gia' scritte esplicitamente, quindi le variabili qui sotto
# hanno effetto solo se modifichi anche i compose.
SPRING_PROFILES_ACTIVE=prod
GATEWAY_PORT=8080